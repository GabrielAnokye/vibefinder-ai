# Optional live LLM explanations. The assistant defaults to offline templates.
# Keep real keys in a local, ignored .env file.
#
# Usage:
#   cp .env.example .env        # .env is git-ignored
#   # fill in the values, then load them into your shell:
#   set -a; source .env; set +a
#   python -m src.main --ask "Music for studying" --provider gemini --trace
#   python -m evaluation.live_experiments plan          # shows request counts; sends nothing
#   python -m evaluation.live_experiments smoke --provider gemini --yes

# Required for --provider gemini
GEMINI_API_KEY=
# Choose an exact model ID available to your project, for example gemini-3.5-flash-lite.
GEMINI_MODEL=

# Required for --provider openrouter
OPENROUTER_API_KEY=
# Required: any model id your account can use, e.g. from https://openrouter.ai/models
OPENROUTER_MODEL=

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # must be https; any OpenAI-compatible endpoint
# OPENROUTER_TIMEOUT=20                              # seconds, clamped to 1-60
# OPENROUTER_MAX_TOKENS=800                          # clamped to 100-2000
